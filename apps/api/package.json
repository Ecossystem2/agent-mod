    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
