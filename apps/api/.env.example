# =============================================================================
# apps/api/.env  — copie para apps/api/.env e preencha
#
# Este arquivo é a ÚNICA fonte de envs do backend + da infraestrutura
# (Postgres e Redis). O root do projeto NÃO tem .env — tudo vive aqui.
#
# O deploy.sh carrega este arquivo via `--env-file apps/api/.env` e o
# docker-compose também usa `env_file: ./apps/api/.env` nos serviços.
# =============================================================================

# ---- Node / app ----
NODE_ENV=production
# PORT é a porta INTERNA do container e está fixa em 3333 no compose
# (`"${API_PORT:-3333}:3333"` + healthcheck em localhost:3333). NÃO mude PORT —
# se mudar, o healthcheck bate na porta errada e o container fica "unhealthy".
# Pra trocar a porta no HOST use API_PORT (lá embaixo).
PORT=3333
LOG_LEVEL=info

# ---- Postgres ----
# DATABASE_URL aponta pro host `postgres` (nome do serviço no docker-compose).
# Pra dev local FORA do docker, troque `postgres` por `localhost`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/template?schema=public

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Auth (better-auth) ----
# Gere com: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-byte-base64
AUTH_BASE_URL=http://localhost:3333
AUTH_TRUSTED_ORIGINS=http://localhost:5173
SECURE_COOKIES=false
# Cookie de sessão. Vazio = host-only (ok p/ dev local e domínio único).
# Quando API e front vivem em SUBDOMÍNIOS do mesmo apex (ex: api.example.com
# e app.example.com), defina o apex com ponto inicial p/ o cookie virar
# first-party nos dois subdomínios em QUALQUER navegador (Safari/iOS, Brave,
# Chrome bloqueando 3rd-party cookies). Sem isso o get-session vem null p/ uns
# navegadores e funciona p/ outros. Exige SECURE_COOKIES=true (HTTPS).
# AUTH_COOKIE_DOMAIN=.example.com

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nº de hops de proxy confiáveis (Express `trust proxy`). Deve bater com a cadeia
# real do deploy: 1 reverse-proxy = 1; CDN→nginx→app = 2. O rate-limit chaveia por
# sessão (não por req.ip), então um valor "errado" não colapsa o throttler, mas
# mantenha-o correto pro `secure`/protocolo do cookie.
TRUST_PROXY=1

# ---- Rate limit ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Backstop por IP bruto (pega rotacao de cookie). Atras de BFF/proxy com IP
# compartilhado vira teto GLOBAL de volume — eleve ou repasse o IP real do cliente.
THROTTLE_IP_LIMIT=1000

# ---- Storage ----
# Default: disk (salva em ./uploads) — bom p/ dev. EM PRODUÇÃO com PII/arquivos
# privados, prefira object storage com URL assinada (TTL): 's3' (AWS), 'r2'
# (Cloudflare) ou MinIO self-hosted. O template já traz o MinIO no docker-compose
# (perfil `storage`): `docker compose --profile storage up -d minio minio-init`.
#
# Config MinIO local (descomente e use STORAGE_DRIVER=s3):
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=app-uploads
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_ENDPOINT é o endpoint da API S3 pra ASSINAR a URL. A URL assinada é
# aberta pelo BROWSER, então tem que ser o host PÚBLICO do MinIO (via nginx/host),
# NÃO o nome interno `minio:9000` (o browser não resolve). Em dev local:
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PUBLIC_URL fica VAZIO pra forçar sempre URL assinada com TTL (bucket
# privado). Só preencha se o bucket for público de leitura.
# STORAGE_PUBLIC_URL=
STORAGE_DRIVER=disk

# ---- Mail ----
# Default: desligado (NoopMailProvider — só loga warn). Ative quando precisar
# enviar email de verdade. Com MAIL_ENABLED=true, SMTP_HOST/PORT/FROM são exigidos.
MAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false

# ---- Webhook (HMAC) ----
# WEBHOOK_SECRET=replace-me

# ---- Bull Board ----
# BULL_BOARD_PATH=/admin/queues

# ---- Portas expostas no host (compose) ----
API_PORT=3333
